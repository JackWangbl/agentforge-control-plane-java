# 复制为 .env 后再启动：cp .env.example .env
# demo 只会在环境变量 SPRING_PROFILES_ACTIVE=demo 时生效，写在这个文件里来不及切换 profile。
# 这个地址只给空库试用。不要改成已经有控制面数据的 MySQL。

APP_ENV=development
DATABASE_URL=mysql+pymysql://agentforge_app:agentforge@127.0.0.1:3306/agentforge?charset=utf8mb4
SECRET_KEY=change-me-before-any-shared-deployment

# 可选
AGENTSCOPE_STUDIO_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
