# Copy this file to .env for local development. Never commit real credentials.
APP_ENV=development
DATABASE_URL=mysql+pymysql://agentforge_app:change-me@127.0.0.1:3306/agentforge?charset=utf8mb4
SECRET_KEY=replace-with-a-long-random-value

# Optional observability integrations
AGENTSCOPE_STUDIO_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional model provider keys. Prefer configuring model credentials in the UI.
OPENAI_API_KEY=
DASHSCOPE_API_KEY=

# Local development only. Keep empty in shared or public environments.
AUTH_DEV_USER=
ALLOW_UNSAFE_LOCAL_SANDBOX=false
BROWSER_ALLOW_PRIVATE_NETWORK=false

