.tabs {
  display: flex;
  background: #ffffff;
  position: sticky;
  top: 0;
  z-index: 5;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  color: #888888;
  font-size: 26rpx;
}

.tab.on {
  color: #4a9eed;
  font-weight: 600;
}

.order {
  padding: 20rpx;
}

.head,
.foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.no,
.time,
.model {
  color: #999999;
  font-size: 22rpx;
}

.status {
  font-size: 26rpx;
}

.status-pending_ship {
  color: #ff8a00;
}

.status-pending_receive {
  color: #4a9eed;
}

.status-done,
.status-cancelled {
  color: #b0b0b0;
}

.goods {
  display: flex;
  margin: 16rpx 0;
}

.thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #0c1a30;
  flex: none;
}

.meta {
  flex: 1;
  margin-left: 16rpx;
}

.name {
  font-size: 28rpx;
}

.price {
  margin-top: 10rpx;
  font-size: 30rpx;
}

.actions {
  display: flex;
}

.btn {
  margin-left: 12rpx;
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
}

.ghost {
  color: #666666;
  border: 1rpx solid #dddddd;
}

.solid {
  color: #ffffff;
  background: #ff3536;
}
