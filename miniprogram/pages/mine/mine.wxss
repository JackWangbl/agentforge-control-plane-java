.profile {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx 48rpx;
  background: #141414;
  color: #ffffff;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: #4a9eed;
  text-align: center;
  line-height: 108rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.who {
  font-size: 34rpx;
  font-weight: 600;
}

.slogan {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
}

.shortcuts {
  display: flex;
  margin-top: -24rpx;
  padding: 24rpx 0;
}

.shortcut {
  flex: 1;
  text-align: center;
}

.count {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #222222;
}

.label {
  display: block;
  margin-top: 6rpx;
  color: #888888;
  font-size: 22rpx;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 24rpx;
  border-bottom: 1rpx solid #f4f4f4;
  font-size: 28rpx;
}

.cell:last-child {
  border-bottom: none;
}

.arrow,
.extra {
  color: #b0b0b0;
  font-size: 24rpx;
}
